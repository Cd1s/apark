<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native Windows UI (WinUI 3, unpackaged, self-contained). Calls the Rust core in apark_ffi.dll. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Apark</RootNamespace>
    <AssemblyName>Apark</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Generates resources.pri / .xbf so XAML loads in an unpackaged app. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>0.1.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\icon.ico" Link="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\icon-256.png" Link="Assets\icon-256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
